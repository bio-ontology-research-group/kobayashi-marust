Prefix(:=<http://example.org/family#>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Ontology(<http://example.org/family>
Declaration(Class(:Person)) Declaration(Class(:Man)) Declaration(Class(:Woman))
Declaration(Class(:Parent)) Declaration(Class(:Mother)) Declaration(Class(:Father))
Declaration(Class(:Grandparent)) Declaration(Class(:Child)) Declaration(Class(:Thing2))
Declaration(Class(:Impossible)) Declaration(Class(:Adult)) Declaration(Class(:Animal))
Declaration(Class(:OnlyChild)) Declaration(Class(:Royal))
Declaration(ObjectProperty(:hasChild)) Declaration(ObjectProperty(:hasParent))
Declaration(ObjectProperty(:hasRelative)) Declaration(ObjectProperty(:hasDescendant))
Declaration(ObjectProperty(:hasGrandchild)) Declaration(ObjectProperty(:hasOffspring))
Declaration(ObjectProperty(:hasSpouse)) Declaration(ObjectProperty(:neverUsed))
Declaration(ObjectProperty(:knows))
Declaration(DataProperty(:age)) Declaration(DataProperty(:yearsOld))
Declaration(NamedIndividual(:alice)) Declaration(NamedIndividual(:bob))
Declaration(NamedIndividual(:carol)) Declaration(NamedIndividual(:dave))
Declaration(NamedIndividual(:eve)) Declaration(NamedIndividual(:elizabeth))
Declaration(NamedIndividual(:lilibet))

SubClassOf(:Man :Person) SubClassOf(:Woman :Person) DisjointClasses(:Man :Woman)
DisjointClasses(:Person :Animal)
EquivalentClasses(:Parent ObjectIntersectionOf(:Person ObjectSomeValuesFrom(:hasChild :Person)))
EquivalentClasses(:Mother ObjectIntersectionOf(:Woman :Parent))
EquivalentClasses(:Father ObjectIntersectionOf(:Man :Parent))
EquivalentClasses(:Grandparent ObjectIntersectionOf(:Person ObjectSomeValuesFrom(:hasGrandchild :Person)))
EquivalentClasses(:Child ObjectIntersectionOf(:Person ObjectSomeValuesFrom(:hasParent :Person)))
EquivalentClasses(:OnlyChild ObjectIntersectionOf(:Child ObjectAllValuesFrom(:hasParent ObjectExactCardinality(1 :hasChild))))
EquivalentClasses(:Thing2 ObjectUnionOf(:Person ObjectComplementOf(:Person)))
SubClassOf(:Impossible ObjectIntersectionOf(:Man :Woman))
EquivalentClasses(:Adult DataSomeValuesFrom(:age DatatypeRestriction(xsd:integer xsd:minInclusive "18"^^xsd:integer)))
EquivalentClasses(:Royal ObjectOneOf(:elizabeth :lilibet))

InverseObjectProperties(:hasChild :hasParent)
SubObjectPropertyOf(:hasChild :hasDescendant)
SubObjectPropertyOf(:hasDescendant :hasRelative)
TransitiveObjectProperty(:hasDescendant)
SubObjectPropertyOf(ObjectPropertyChain(:hasChild :hasChild) :hasGrandchild)
SubObjectPropertyOf(:hasGrandchild :hasDescendant)
EquivalentObjectProperties(:hasChild :hasOffspring)
SymmetricObjectProperty(:hasSpouse)
SubObjectPropertyOf(:hasSpouse :hasRelative)
SubClassOf(ObjectSomeValuesFrom(:neverUsed owl:Thing) owl:Nothing)
ObjectPropertyDomain(:hasChild :Person) ObjectPropertyRange(:hasChild :Person)
ObjectPropertyDomain(:knows :Person)
SubDataPropertyOf(:yearsOld :age) FunctionalDataProperty(:age)
DataPropertyDomain(:age :Person)

ClassAssertion(:Woman :alice) ClassAssertion(:Man :bob) ClassAssertion(:Woman :carol)
ClassAssertion(:Man :dave)
ObjectPropertyAssertion(:hasChild :alice :carol)
ObjectPropertyAssertion(:hasChild :carol :dave)
ObjectPropertyAssertion(:hasSpouse :alice :bob)
ObjectPropertyAssertion(:knows :eve :bob)
DataPropertyAssertion(:yearsOld :alice "61"^^xsd:integer)
DataPropertyAssertion(:age :dave "9"^^xsd:integer)
SameIndividual(:elizabeth :lilibet)
DifferentIndividuals(:alice :bob :carol :dave)
Declaration(Class(<urn:q#Q>)) EquivalentClasses(<urn:q#Q> ObjectSomeValuesFrom(owl:topObjectProperty owl:Thing)) )
