Prefix(:=<http://example.org/rules#>)
Ontology(<http://example.org/rules/consistent>
Declaration(Class(:Person))
Declaration(Class(:Parent))
Declaration(Class(:Human))
Declaration(ObjectProperty(:hasChild))
Declaration(ObjectProperty(:childOf))
Declaration(NamedIndividual(:alice))
Declaration(NamedIndividual(:bob))
InverseObjectProperties(:hasChild :childOf)
SubClassOf(:Parent :Person)
SubClassOf(:Person :Human)
ObjectPropertyAssertion(:hasChild :alice :bob)
ClassAssertion(:Person :alice)
DLSafeRule(Body(ObjectPropertyAtom(:hasChild Variable(:x) Variable(:y))) Head(ClassAtom(:Parent Variable(:x))))
)
