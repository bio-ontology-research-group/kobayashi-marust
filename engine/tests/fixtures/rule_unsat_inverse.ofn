Prefix(:=<http://example.org/rules#>)
Ontology(<http://example.org/rules/unsat>
Declaration(Class(:KeyAttr))
Declaration(Class(:NonKeyAttr))
Declaration(ObjectProperty(:partOf))
Declaration(ObjectProperty(:hasPart))
Declaration(NamedIndividual(:a))
Declaration(NamedIndividual(:b))
InverseObjectProperties(:partOf :hasPart)
DisjointClasses(:KeyAttr :NonKeyAttr)
ClassAssertion(:KeyAttr :a)
ObjectPropertyAssertion(:partOf :a :b)
DLSafeRule(Body(ClassAtom(:KeyAttr Variable(:x))) Head(ClassAtom(:NonKeyAttr Variable(:x))))
)
