#!/bin/bash
# one-x1: run /mnt/data2/workspaces/leechuck/software/kobayashi-marust/.work/agent-scratch/nominal-exchange/km.x3 on one CPU (available_parallelism 1, so the route's KM_THREADS=16 is capped to 1); CPUs 50-52 are claimed by lock files
for c in 50 51 52 53 54 55; do
  exec 9>/mnt/data2/workspaces/leechuck/software/kobayashi-marust/.work/agent-scratch/nominal-exchange/locks/cpu$c
  if flock -n 9; then exec taskset -c $c /mnt/data2/workspaces/leechuck/software/kobayashi-marust/.work/agent-scratch/nominal-exchange/km.x3 "$@"; fi
done
exec taskset -c 55 /mnt/data2/workspaces/leechuck/software/kobayashi-marust/.work/agent-scratch/nominal-exchange/km.x3 "$@"
