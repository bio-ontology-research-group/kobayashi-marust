-        let d = sig.concept("D");
-        let e = sig.concept("E");
-        let f = sig.concept("F");
-        let g = sig.concept("G");
-        let cc = |body: Vec<Pred>, head: Vec<Lit>| ContextClause::new(body, head, true, &sig);
