+    /// Experimental relocation of positive and negative links through an
+    /// equality merge. Every copied edge carries its original dependency and
+    /// the equality dependency. Arena mutation retains the branch journal.
+    pub(super) fn ht_relocate_disjoint_merge_connections(
+        &mut self, from: NodeId, into: NodeId, merge_dependency: TrackPointId,
+        ctx: &mut CalculationAlgorithmContextBase,
+    ) -> bool {
+        let from_id = ctx.process_context().node(from).individual_node_id();
+        let connections = ctx.process_context().node_role_neighbor_ids(from);
+        let mut neighbors = Vec::new();
+        for id in connections {
+            let node = self.get_up_to_date_individual_by_id(id, ctx);
+            if node.is_none() { ctx.raise_stop(false); return false; }
+            neighbors.push(node);
+        }
+        neighbors.push(from);
+        neighbors.push(into);
+        neighbors.sort_unstable_by_key(|node| node.index());
+        neighbors.dedup();
