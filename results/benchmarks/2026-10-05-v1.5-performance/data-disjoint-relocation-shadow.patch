+            ctx.process_context_mut().node_remove_disjoint_links(neighbor, from_id);
+            ctx.process_context_mut().node_remove_disjoint_links(from, neighbor_id);
+            ctx.process_context_mut().node_remove_individual_connection(neighbor, from);
+            ctx.process_context_mut().node_remove_individual_connection(from, neighbor);
+        }
