diff --git a/engine/src/konclude_ht/process/context.rs b/engine/src/konclude_ht/process/context.rs
index 3cea8bdd..5f3fe20f 100644
--- a/engine/src/konclude_ht/process/context.rs
+++ b/engine/src/konclude_ht/process/context.rs
@@ -7449,0 +7450,21 @@ impl ProcessContext {
+    /// Every incident role neighbour, including outgoing negative-only edges.
+    /// Connection successors alone enumerate incoming links, not this union.
+    pub(crate) fn node_role_neighbor_ids(&self, node: NodeId) -> Vec<Cint64> {
+        let mut ids = Vec::new();
+        let mut incoming = self.node_connection_successor_iterator(node);
+        while incoming.has_next() {
+            ids.push(incoming.next_successor_connection_id(true));
+        }
+        let mut outgoing = self.node_successor_iterator(node);
+        while outgoing.has_next() {
+            ids.push(outgoing.next_individual_id(true));
+        }
+        let negative = self.node(node).use_disjoint_succ_role_hash;
+        if negative.is_some() {
+            ids.extend(self.disjoint_succ_role_hash(negative).successor_ids());
+        }
+        ids.sort_unstable();
+        ids.dedup();
+        ids
+    }
