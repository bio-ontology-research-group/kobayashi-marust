+    /// Experimental relocation of positive and negative links through an
+    /// equality merge. Every copied edge carries its original dependency and
+    /// the equality dependency. Arena mutation retains the branch journal.
+    pub(super) fn ht_relocate_disjoint_merge_connections(
+        &mut self, from: NodeId, into: NodeId, merge_dependency: TrackPointId,
+        ctx: &mut CalculationAlgorithmContextBase,
+    ) -> bool {
+        let from_id = ctx.process_context().node(from).individual_node_id();
+        let connections = ctx.process_context().node_role_neighbor_ids(from);
+        let mut neighbors = Vec::new();
+        for id in connections {
+            let node = self.get_up_to_date_individual_by_id(id, ctx);
+            if node.is_none() { ctx.raise_stop(false); return false; }
+            neighbors.push(node);
+        }
+        neighbors.push(from);
+        neighbors.push(into);
+        neighbors.sort_unstable_by_key(|node| node.index());
+        neighbors.dedup();
+        let mut positive = Vec::new();
+        let mut negative = Vec::new();
+        for &neighbor in &neighbors {
+            let neighbor_id = ctx.process_context().node(neighbor).individual_node_id();
+            for (source, target, target_id) in [(from, neighbor, neighbor_id), (neighbor, from, from_id)] {
+                let mut links = ctx.process_context().node_successor_role_iterator(source, target_id);
+                while links.has_next() {
+                    let link = links.next(true);
+                    let edge = ctx.process_context().edge(link);
+                    positive.push((source, target, link, edge.get_link_role(), edge.get_dependency_track_point()));
+                }
+                let mut links = ctx.process_context().node_disjoint_successor_role_iterator(source, target_id);
+                while links.has_next() {
+                    let edge = ctx.process_context().disjoint_edge(links.next(true));
+                    negative.push((source, target, edge.get_link_role(), edge.get_dependency_track_point()));
+                }
+            }
+        }
+        for &(source, target, _, role, old_dependency) in &positive {
+            let source = if source == from { into } else { source };
+            let target = if target == from { into } else { target };
+            let mut dependency = TrackPointId::NONE;
+            let mut into_mut = into;
+            self.create_merged_link_dependency(&mut dependency, &mut into_mut,
+                merge_dependency, old_dependency, ctx);
+            self.ht_install_role_successor_edge(source, target, role, dependency, ctx);
+            if ctx.has_pending_signal() { return false; }
+        }
+        for (source, target, role, old_dependency) in negative {
+            let mut source = if source == from { into } else { source };
+            let mut target = if target == from { into } else { target };
+            let mut dependency = TrackPointId::NONE;
+            let mut into_mut = into;
+            self.create_merged_link_dependency(&mut dependency, &mut into_mut,
+                merge_dependency, old_dependency, ctx);
+            self.create_individual_node_negation_link(&mut source, &mut target, role, dependency, ctx);
+            if ctx.has_pending_signal() { return false; }
+        }
