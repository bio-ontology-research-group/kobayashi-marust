+#[cfg(test)]
+mod experimental_padding_tests {
+    use super::*;
+
+    #[test]
+    fn datatype_padding_witness_checks_every_source_axiom() {
+        let mut input: TInput = serde_json::from_value(serde_json::json!({
+            "concepts": ["A", "B", "Parent"], "roles": ["data"], "clauses": [],
+            "source_axioms": [
+                {"kind":"equivalent", "left":{"Name":"A"}, "right":{"Not":{"Name":"B"}}},
+                {"kind":"sub-class", "left":{"Name":"A"}, "right":{"Name":"Parent"}},
+                {"kind":"sub-class", "left":{"Name":"B"}, "right":{"Name":"Parent"}}
+            ]
+        })).unwrap();
+        let witness = find_data_padding_type(&input).unwrap();
+        assert!(witness.contains("Parent"));
+        assert_ne!(witness.contains("A"), witness.contains("B"));
+        // Either choice now activates a datatype-bearing existential. Skipping
+        // those axioms would incorrectly accept a padding node with no edge.
+        for name in ["A", "B"] {
+            input.source_axioms.push(serde_json::from_value(serde_json::json!({
+                "kind":"sub-class", "left":{"Name":name},
+                "right":{"Exists":[{"Name":"data"},{"Name":"__dt__integer"}]}
+            })).unwrap());
+        }
+        assert!(find_data_padding_type(&input).is_none());
+        assert_eq!(padding_data_node_holds(&SourceConcept::Nominal("a".into()), &witness), Some(false));
+        assert_eq!(padding_data_node_holds(&SourceConcept::Name("__dt__integer".into()), &witness), None);
+        assert_eq!(padding_data_node_holds(&SourceConcept::Forall(SourceRole::Universal,
+            Box::new(SourceConcept::Top)), &witness), None);
+    }
