+// Experimental source-GCI witness only. No production admission change until
+// concrete datatype transport, RBox/ABox coverage and source binding are proved.
+fn find_data_padding_type(tin: &TInput) -> Option<std::collections::HashSet<String>> {
+    use crate::json_io::SourceAxiomKind;
+    let satisfies = |positive: &std::collections::HashSet<String>| {
+        tin.source_axioms.iter().all(|axiom| {
+            let (Some(left), Some(right)) = (padding_data_node_holds(&axiom.left, positive),
+                padding_data_node_holds(&axiom.right, positive)) else { return false };
+            match axiom.kind {
+                SourceAxiomKind::SubClass => !left || right,
+                SourceAxiomKind::Equivalent => left == right,
+                SourceAxiomKind::Disjoint => !(left && right),
+            }
+        })
+    };
+    let empty = std::collections::HashSet::new();
+    if satisfies(&empty) { return Some(empty); }
+    for seed in tin.concepts.iter().filter(|name| !name.starts_with("__")).take(256) {
+        let mut positive = std::collections::HashSet::from([seed.clone()]);
+        loop {
+            let before = positive.len();
+            for axiom in &tin.source_axioms {
+                if axiom.kind != SourceAxiomKind::SubClass { continue; }
+                let SourceConcept::Name(name) = &axiom.right else { continue };
+                if name.starts_with("__dt__") { continue; }
+                if padding_data_node_holds(&axiom.left, &positive) == Some(true) {
+                    positive.insert(name.clone());
+                }
+            }
+            if positive.len() == before { break; }
+        }
+        // Check every source axiom, including data-bearing ones. A positive
+        // padding class must not activate a missing existential data edge.
+        if satisfies(&positive) { return Some(positive); }
+    }
+    None
+}
