#!/bin/bash
#SBATCH --job-name=km-14817-kon-order-fixed
#SBATCH --account=pi-hohndor
#SBATCH --partition=debug
#SBATCH --time=00:07:00
#SBATCH --cpus-per-task=1
#SBATCH --mem=20G
#SBATCH --output=/ibex/scratch/hohndor/km/14817_closure_20260714/slurm/km-kon-order-fixed-%j.out

set -u

root=/ibex/scratch/hohndor/km/14817_closure_20260714
binary=$root/km-14817-sat-exp-or-commit
tin=$root/standalone/14817.tin.json
run=$root/km-konclude-order-replay-fixed
mkdir -p "$run" "$root/slurm"

# The first 184 actual satisfiability jobs from Konclude's one-worker
# KCLASSDBG trace, mapped to the shared TInput subject ids. NBO_0000042 is last.
order=76519,73906,78017,76627,76500,73659,84219,77136,84195,76122,35248,81359,84184,82997,76032,77163,82991,76017,35591,82737,76214,84014,87425,81152,79246,38567,80332,37628,37548,37949,37056,37847,37626,81239,37082,37690,38514,79202,37080,81200,37371,40613,36427,35748,37705,40126,82487,40190,42067,39777,40210,84142,81913,39910,40123,37851,35036,40768,40239,35733,35352,37698,35657,43116,81215,39290,81004,41672,39816,84164,40673,38557,37485,86126,42660,39822,40932,80306,78983,40281,79164,81466,81388,82826,37888,87332,87309,87230,84421,87404,76237,87218,79134,38277,83671,76664,85061,82348,79165,82786,86740,82695,42925,87219,78992,87320,84183,84488,87268,35868,38392,83776,86696,43006,41787,82605,86613,87344,41661,85389,39890,38733,84236,81551,82277,81917,87287,82838,87231,82317,78085,81503,77911,34935,83120,87285,82836,87363,83774,80863,81018,87232,85224,86940,81689,79243,41841,87354,84156,44696,83624,40188,82956,86121,81549,83126,87540,77888,84005,78482,83612,81854,84473,84985,84481,84468,76143,77405,84469,84464,85623,84460,84036,84969,84461,84470,84994,84484,84472,74410,74413,73676,73648,73652

echo "BEGIN host=$(hostname) date=$(date -Is) binary_sha256=$(/usr/bin/sha256sum "$binary" | /usr/bin/cut -d' ' -f1)"
set +e
/usr/bin/time -v -o "$run/14817.time" \
/usr/bin/timeout -k 5 240 \
  /usr/bin/env \
    KM_HT=1 \
    KM_HT_BRIDGE=1 \
    KM_HT_BRIDGE_ONLY=1 \
    KM_HT_FORCE=1 \
    KM_HT_CARD=1 \
    KM_HT_PAR=1 \
    KM_HT_QO_SHIQ=1 \
    KM_HT_BLOCK=5 \
    KM_HT_EAGER=1 \
    KM_HT_NEGTRIED=1 \
    KM_HT_ORD=1 \
    KM_HT_INCRBLOCK2=1 \
    KM_HT_INCROBLIG=1 \
    KM_TRIGGER_ABSORB=1 \
    KM_KEEP_CHAIN_AXIOMS=1 \
    KM_HT_SATURATION=1 \
    KM_HT_NO_SATCACHE=1 \
    KM_BRIDGE_ORDER_SUBJECTS="$order" \
    KM_BRIDGE_ORDER_ONLY=1 \
    KM_HT_SATURATION_BUDGET_S=180 \
    KM_BRIDGE_PROBE_BUDGET_S=30 \
    KM_BRIDGE_RETRY_ROUNDS=0 \
    KM_HT_STATS=1 \
    KM_BRIDGE_PROGRESS=1 \
    KM_HT_SATEXP_STATS=1 \
    KM_SAT_COUNTERS=1 \
    "$binary" tableau \
    < "$tin" \
    > "$run/14817.json" \
    2> "$run/14817.stderr"
status=$?
set -e

echo "RESULT exit=$status bytes=$(/usr/bin/stat -c %s "$run/14817.json")"
/usr/bin/grep -E \
  '^(BRIDGE-(SATURATION|DEFER|PREPARE|VERIFY|CLASSIFY)|PROGRESS-SAT|HT-STATS)' \
  "$run/14817.stderr" | tail -n 160 || true
/usr/bin/grep -E 'Elapsed \(wall clock\)|Maximum resident set size' "$run/14817.time" || true
echo "END date=$(date -Is)"
