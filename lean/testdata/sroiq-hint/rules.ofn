DLSafeRule(Body(ClassAtom(:A Variable(<urn:swrl#x>)) ObjectPropertyAtom(:r Variable(<urn:swrl#x>) Variable(<urn:swrl#y>))) Head(ClassAtom(:D Variable(<urn:swrl#y>))))
