Prefix(:=<http://ex/>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Ontology(<http://ex/datarows-axioms>
DataPropertyAssertion(:age :p "42"^^xsd:integer)
DataPropertyAssertion(:age :p "43"^^xsd:integer)
NegativeDataPropertyAssertion(:age :p "42"^^xsd:integer)
NegativeDataPropertyAssertion(:age :p "43"^^xsd:integer)
DataPropertyAssertion(:name :p "x")
FunctionalDataProperty(:name)
SubDataPropertyOf(:age :name)
DisjointDataProperties(:age :name)
DataPropertyRange(:age xsd:string)
DataPropertyRange(:age xsd:integer)
DataPropertyDomain(:name :Aged)
SubClassOf(:Person DataSomeValuesFrom(:age xsd:integer))
SubClassOf(:Aged DataHasValue(:age "42"^^xsd:integer))
ClassAssertion(DataMaxCardinality(0 :age) :p)
ClassAssertion(DataMinCardinality(1 :age xsd:decimal) :p)
ClassAssertion(ObjectMaxCardinality(2 owl:topObjectProperty) :p)
EquivalentDataProperties(:age :name)
DataPropertyAssertion(:age :p "42.0"^^xsd:decimal)
)
