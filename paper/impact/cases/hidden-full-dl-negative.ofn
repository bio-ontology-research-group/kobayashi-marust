Prefix(:=<http://example.org/impact#>)
Ontology(<http://example.org/impact/hidden-full-dl-negative>
 Declaration(Class(:ExternalFinding))
 Declaration(Class(:IntegratedFinding))
 Declaration(Class(:AnatomicalStructure))
 Declaration(Class(:PathologicalProcess))
