Prefix(:=<http://example.org/km-impact/configuration#>)
Ontology(<http://example.org/km-impact/product-configuration-control>
 Declaration(Class(:ConfiguredDrone))
 Declaration(Class(:DualSensorSurveyDrone))
 Declaration(Class(:Payload))
 Declaration(Class(:OpticalCamera))
 Declaration(Class(:ThermalCamera))
 Declaration(ObjectProperty(:hasPayload))
 SubClassOf(:OpticalCamera :Payload)
 SubClassOf(:ThermalCamera :Payload)
 DisjointClasses(:OpticalCamera :ThermalCamera)
 SubClassOf(:DualSensorSurveyDrone :ConfiguredDrone)
 SubClassOf(:DualSensorSurveyDrone ObjectSomeValuesFrom(:hasPayload :OpticalCamera))
 SubClassOf(:DualSensorSurveyDrone ObjectSomeValuesFrom(:hasPayload :ThermalCamera))
)
