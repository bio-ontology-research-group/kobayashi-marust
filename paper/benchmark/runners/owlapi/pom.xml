<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.kmbenchmark</groupId>
  <artifactId>full-iri-classifier</artifactId>
  <version>1</version>
  <properties>
    <maven.compiler.release>11</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>
  <build>
    <sourceDirectory>${project.basedir}</sourceDirectory>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <includes>
            <include>FullIriClassifier.java</include>
            <include>FreezeImports.java</include>
            <include>ProfileOntology.java</include>
            <include>ConvertSyntax.java</include>
          </includes>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <finalName>classifier-${baseline.id}</finalName>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>org.kmbenchmark.FullIriClassifier</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>hermit</id><properties><baseline.id>hermit</baseline.id></properties>
      <dependencies><dependency><groupId>net.sourceforge.owlapi</groupId><artifactId>org.semanticweb.hermit</artifactId><version>1.4.5.519</version></dependency></dependencies>
    </profile>
    <profile>
      <id>jfact</id><properties><baseline.id>jfact</baseline.id></properties>
      <dependencies><dependency><groupId>net.sourceforge.owlapi</groupId><artifactId>jfact</artifactId><version>5.0.3</version></dependency></dependencies>
    </profile>
    <profile>
      <id>openllet</id><properties><baseline.id>openllet</baseline.id></properties>
      <dependencies><dependency><groupId>com.github.galigator.openllet</groupId><artifactId>openllet-owlapi</artifactId><version>2.6.5</version></dependency></dependencies>
    </profile>
    <profile>
      <id>elk</id><properties><baseline.id>elk</baseline.id></properties>
      <dependencies><dependency><groupId>io.github.liveontologies</groupId><artifactId>elk-owlapi</artifactId><version>0.6.0</version></dependency></dependencies>
    </profile>
    <profile>
      <id>whelk</id><properties><baseline.id>whelk</baseline.id></properties>
      <dependencies><dependency><groupId>org.geneontology</groupId><artifactId>whelk-owlapi_2.13</artifactId><version>1.2.1</version></dependency></dependencies>
    </profile>
  </profiles>
</project>
