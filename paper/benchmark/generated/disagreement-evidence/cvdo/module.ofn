AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FMA_67135> "FMA:67135")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FMA_67135> "Anatomical structure")
