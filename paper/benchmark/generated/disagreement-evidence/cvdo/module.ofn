TransitiveObjectProperty(Annotation(<http://purl.obolibrary.org/obo/IAO_0010000> <http://purl.obolibrary.org/obo/bfo/axiom/106>) <http://purl.obolibrary.org/obo/BFO_0000117>)
ObjectPropertyDomain(Annotation(<http://purl.obolibrary.org/obo/IAO_0010000> <http://purl.obolibrary.org/obo/bfo/axiom/105>) <http://purl.obolibrary.org/obo/BFO_0000117> <http://purl.obolibrary.org/obo/BFO_0000003>)
ObjectPropertyRange(Annotation(<http://purl.obolibrary.org/obo/IAO_0010000> <http://purl.obolibrary.org/obo/bfo/axiom/104>) <http://purl.obolibrary.org/obo/BFO_0000117> <http://purl.obolibrary.org/obo/BFO_0000003>)

# Object Property: <http://purl.obolibrary.org/obo/BFO_0000121> (has temporal part)

AnnotationAssertion(<http://purl.obolibrary.org/obo/BFO_0000179> <http://purl.obolibrary.org/obo/BFO_0000121> "has-t-part")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000112> <http://purl.obolibrary.org/obo/BFO_0000121> "[copied from inverse property 'temporal part of'] the 4th year of your life is a temporal part of your life\\. The first quarter of a game of football is a temporal part of the whole game\\. The process of your heart beating from 4pm to 5pm today is a temporal part of the entire process of your heart beating.\\ The 4th year of your life is a temporal part of your life")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000112> <http://purl.obolibrary.org/obo/BFO_0000121> "[copied from inverse property 'temporal part of'] the process boundary which separates the 3rd and 4th years of your life.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000112> <http://purl.obolibrary.org/obo/BFO_0000121> "[copied from inverse property 'temporal part of'] your heart beating from 4pm to 5pm today is a temporal part of the process of your heart beating")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/BFO_0000121> "[copied from inverse property 'temporal part of'] b proper_temporal_part_of c =Def. b temporal_part_of c & not (b = c). (axiom label in BFO2 Reference: [116-001])")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/BFO_0000121> "[copied from inverse property 'temporal part of'] b temporal_part_of c =Def.b occurrent_part_of c & & for some temporal region t, b occupies_temporal_region t & for all occurrents d, t (if d occupies_temporal_region t  & t? occurrent_part_of t then (d occurrent_part_of a iff d occurrent_part_of b)). (axiom label in BFO2 Reference: [078-003])")
AnnotationAssertion(rdfs:isDefinedBy <http://purl.obolibrary.org/obo/BFO_0000121> <http://purl.obolibrary.org/obo/bfo.owl>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/BFO_0000121> "has temporal part"@en)
SubObjectPropertyOf(<http://purl.obolibrary.org/obo/BFO_0000121> <http://purl.obolibrary.org/obo/BFO_0000117>)
InverseObjectProperties(<http://purl.obolibrary.org/obo/BFO_0000121> <http://purl.obolibrary.org/obo/BFO_0000139>)
TransitiveObjectProperty(Annotation(<http://purl.obolibrary.org/obo/IAO_0010000> <http://purl.obolibrary.org/obo/bfo/axiom/129>) <http://purl.obolibrary.org/obo/BFO_0000121>)
ObjectPropertyDomain(Annotation(<http://purl.obolibrary.org/obo/IAO_0010000> <http://purl.obolibrary.org/obo/bfo/axiom/128>) <http://purl.obolibrary.org/obo/BFO_0000121> <http://purl.obolibrary.org/obo/BFO_0000003>)
ObjectPropertyRange(Annotation(<http://purl.obolibrary.org/obo/IAO_0010000> <http://purl.obolibrary.org/obo/bfo/axiom/127>) <http://purl.obolibrary.org/obo/BFO_0000121> <http://purl.obolibrary.org/obo/BFO_0000003>)

# Object Property: <http://purl.obolibrary.org/obo/BFO_0000123> (has spatial occupant at some time)

AnnotationAssertion(<http://purl.obolibrary.org/obo/BFO_0000179> <http://purl.obolibrary.org/obo/BFO_0000123> "r-location-of_st")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000116> <http://purl.obolibrary.org/obo/BFO_0000123> "[copied from inverse property 'occupies spatial region at some time'] Alan Ruttenberg: This is a binary version of a ternary time-indexed, instance level, relation. The BFO reading of the binary relation 'occupies spatial region at some time@en' is: exists t,  exists_at(x,t) & exists_at(y,t) & 'occupies spatial region@en'(x,y,t)")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000116> <http://purl.obolibrary.org/obo/BFO_0000123> "[copied from inverse property 'occupies spatial region at some time'] BFO2 Reference: independent continuant")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000116> <http://purl.obolibrary.org/obo/BFO_0000123> "[copied from inverse property 'occupies spatial region at some time'] BFO2 Reference: spatial region")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000600> <http://purl.obolibrary.org/obo/BFO_0000123> "[copied from inverse property 'occupies spatial region at some time'] b occupies_spatial_region r at t means that r is a spatial region in which independent continuant b is exactly located (axiom label in BFO2 Reference: [041-002])")
AnnotationAssertion(rdfs:isDefinedBy <http://purl.obolibrary.org/obo/BFO_0000123> <http://purl.obolibrary.org/obo/bfo.owl>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/BFO_0000123> "has spatial occupant at some time"@en)
ObjectPropertyDomain(Annotation(<http://purl.obolibrary.org/obo/IAO_0010000> <http://purl.obolibrary.org/obo/bfo/axiom/516>) <http://purl.obolibrary.org/obo/BFO_0000123> <http://purl.obolibrary.org/obo/BFO_0000006>)
ObjectPropertyRange(Annotation(<http://purl.obolibrary.org/obo/IAO_0010000> <http://purl.obolibrary.org/obo/bfo/axiom/041-002>) <http://purl.obolibrary.org/obo/BFO_0000123> <http://purl.obolibrary.org/obo/BFO_0000004>)

