SubClassOf(<http://www.biomodels.net/kisao/KISAO#KISAO_0000094> ObjectSomeValuesFrom(<http://www.biomodels.net/kisao/KISAO#KISAO_0000245> <http://www.biomodels.net/kisao/KISAO#KISAO_0000103>))
SubClassOf(<http://www.biomodels.net/kisao/KISAO#KISAO_0000094> ObjectSomeValuesFrom(<http://www.biomodels.net/kisao/KISAO#KISAO_0000245> <http://www.biomodels.net/kisao/KISAO#KISAO_0000106>))
SubClassOf(<http://www.biomodels.net/kisao/KISAO#KISAO_0000094> ObjectSomeValuesFrom(<http://www.biomodels.net/kisao/KISAO#KISAO_0000245> <http://www.biomodels.net/kisao/KISAO#KISAO_0000107>))
SubClassOf(<http://www.biomodels.net/kisao/KISAO#KISAO_0000094> ObjectSomeValuesFrom(<http://www.biomodels.net/kisao/KISAO#KISAO_0000245> <http://www.biomodels.net/kisao/KISAO#KISAO_0000374>))

# Class: <http://www.biomodels.net/kisao/KISAO#KISAO_0000095> (sub-volume stochastic reaction-diffusion algorithm)

AnnotationAssertion(<http://purl.org/dc/terms/created> <http://www.biomodels.net/kisao/KISAO#KISAO_0000095> "2008-07-08"^^xsd:date)
