AnnotationAssertion(<http://www.biomodels.net/kisao/KISAO#isOrganizational> <http://www.biomodels.net/kisao/KISAO#KISAO_0000100> "true"^^xsd:boolean)
AnnotationAssertion(rdfs:label <http://www.biomodels.net/kisao/KISAO#KISAO_0000100> "type of progression time step"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://www.biomodels.net/kisao/KISAO#KISAO_0000100> "Type of time steps used by the algorithm."@en)
SubClassOf(<http://www.biomodels.net/kisao/KISAO#KISAO_0000100> <http://www.biomodels.net/kisao/KISAO#KISAO_0000097>)

# Class: <http://www.biomodels.net/kisao/KISAO#KISAO_0000102> (spatial description)

AnnotationAssertion(<http://purl.org/dc/terms/created> <http://www.biomodels.net/kisao/KISAO#KISAO_0000102> "2008-07-08"^^xsd:date)
