AnnotationAssertion(rdfs:label <http://www.biomodels.net/kisao/KISAO#KISAO_0000302> "embedded Runge-Kutta method"@en)
AnnotationAssertion(Annotation(rdfs:comment "Hairer, Ernst; Nørsett, Syvert Paul; Wanner, Gerhard (1993), Solving ordinary differential equations I: Nonstiff problems (2nd ed.), Berlin: Springer Verlag"@en) rdfs:seeAlso <http://www.biomodels.net/kisao/KISAO#KISAO_0000302> "http://identifiers.org/isbn/978-3-540-56670-0"^^xsd:anyURI)
AnnotationAssertion(Annotation(rdfs:comment "EXACT"@en) <http://www.w3.org/2004/02/skos/core#altLabel> <http://www.biomodels.net/kisao/KISAO#KISAO_0000302> "embedded RK"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://www.biomodels.net/kisao/KISAO#KISAO_0000302> "An embedded Runge-Kutta method is a method in which two Runge-Kutta estimates are obtained using the same auxiliary functions ki but with a different linear combination of these functions so that one estimate has an order one greater than the other."@en)
SubClassOf(<http://www.biomodels.net/kisao/KISAO#KISAO_0000302> <http://www.biomodels.net/kisao/KISAO#KISAO_0000064>)
