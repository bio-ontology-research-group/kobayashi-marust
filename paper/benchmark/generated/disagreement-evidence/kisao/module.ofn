AnnotationAssertion(<http://www.biomodels.net/kisao/KISAO#isOrganizational> <http://www.biomodels.net/kisao/KISAO#KISAO_0000098> "true"^^xsd:boolean)
AnnotationAssertion(rdfs:label <http://www.biomodels.net/kisao/KISAO#KISAO_0000098> "type of variable"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://www.biomodels.net/kisao/KISAO#KISAO_0000098> "Type of variables used for the simulation."@en)
SubClassOf(<http://www.biomodels.net/kisao/KISAO#KISAO_0000098> <http://www.biomodels.net/kisao/KISAO#KISAO_0000097>)

# Class: <http://www.biomodels.net/kisao/KISAO#KISAO_0000099> (type of system behaviour)

AnnotationAssertion(<http://purl.org/dc/terms/creator> <http://www.biomodels.net/kisao/KISAO#KISAO_0000099> "AZ"@en)
AnnotationAssertion(<http://www.biomodels.net/kisao/KISAO#isOrganizational> <http://www.biomodels.net/kisao/KISAO#KISAO_0000099> "true"^^xsd:boolean)
AnnotationAssertion(rdfs:label <http://www.biomodels.net/kisao/KISAO#KISAO_0000099> "type of system behaviour"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://www.biomodels.net/kisao/KISAO#KISAO_0000099> "A characteristic describing the rules the algorithm uses to simulate the temporal evolution of a system, specifically whether or not the final state is uniquely determined from a precise initial state."@en)
SubClassOf(<http://www.biomodels.net/kisao/KISAO#KISAO_0000099> <http://www.biomodels.net/kisao/KISAO#KISAO_0000097>)

