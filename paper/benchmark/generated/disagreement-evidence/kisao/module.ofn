AnnotationAssertion(<http://purl.org/dc/terms/created> <http://www.biomodels.net/kisao/KISAO#KISAO_0000378> "2011-06-30"^^xsd:date)
AnnotationAssertion(<http://purl.org/dc/terms/creator> <http://www.biomodels.net/kisao/KISAO#KISAO_0000378> "AZ"@en)
AnnotationAssertion(<http://www.biomodels.net/kisao/KISAO#isImplementedIn> <http://www.biomodels.net/kisao/KISAO#KISAO_0000378> "GSL"@en)
AnnotationAssertion(rdfs:label <http://www.biomodels.net/kisao/KISAO#KISAO_0000378> "implicit midpoint rule"@en)
AnnotationAssertion(Annotation(rdfs:comment "Hairer, Ernst; Nørsett, Syvert Paul; Wanner, Gerhard (1993), Solving ordinary differential equations I: Nonstiff problems (2nd ed.), Berlin: Springer Verlag."@en) rdfs:seeAlso <http://www.biomodels.net/kisao/KISAO#KISAO_0000378> "http://identifiers.org/isbn/978-3-540-56670-0"^^xsd:anyURI)
AnnotationAssertion(Annotation(rdfs:comment "EXACT"@en) <http://www.w3.org/2004/02/skos/core#altLabel> <http://www.biomodels.net/kisao/KISAO#KISAO_0000378> "implicit Gaussian second order Runge-Kutta method"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://www.biomodels.net/kisao/KISAO#KISAO_0000378> "The implicit midpoint rule is a second-order case of the more general implicit s-stage Runge-Kutta methods [http://identifiers.org/biomodels.kisao/KISAO_0000064 and (http://identifiers.org/biomodels.kisao/KISAO_0000245 some http://identifiers.org/biomodels.kisao/KISAO_0000240)]."@en)
SubClassOf(<http://www.biomodels.net/kisao/KISAO#KISAO_0000378> <http://www.biomodels.net/kisao/KISAO#KISAO_0000064>)
