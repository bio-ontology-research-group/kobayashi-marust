AnnotationAssertion(<http://purl.org/dc/terms/creator> <http://www.biomodels.net/kisao/KISAO#KISAO_0000106> "NLN"@en)
AnnotationAssertion(rdfs:label <http://www.biomodels.net/kisao/KISAO#KISAO_0000106> "continuous variable"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://www.biomodels.net/kisao/KISAO#KISAO_0000106> "Algorithm, possessing this characteristic, allows the values of a system's variables to change by continuous (non-integral) amounts."@en)
SubClassOf(<http://www.biomodels.net/kisao/KISAO#KISAO_0000106> <http://www.biomodels.net/kisao/KISAO#KISAO_0000098>)
SubClassOf(<http://www.biomodels.net/kisao/KISAO#KISAO_0000106> ObjectSomeValuesFrom(<http://www.biomodels.net/kisao/KISAO#KISAO_0000245> <http://www.biomodels.net/kisao/KISAO#KISAO_0000104>))

# Class: <http://www.biomodels.net/kisao/KISAO#KISAO_0000107> (progression with adaptive time step)

AnnotationAssertion(<http://purl.org/dc/terms/created> <http://www.biomodels.net/kisao/KISAO#KISAO_0000107> "2008-07-08"^^xsd:date)
AnnotationAssertion(<http://purl.org/dc/terms/creator> <http://www.biomodels.net/kisao/KISAO#KISAO_0000107> "NLN"@en)
AnnotationAssertion(rdfs:label <http://www.biomodels.net/kisao/KISAO#KISAO_0000107> "progression with adaptive time step"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://www.biomodels.net/kisao/KISAO#KISAO_0000107> "Algorithm, possessing this characteristic, does not use fixed time steps to update the state of a system during the whole simulation, but on the contrary adapts the length of the time steps to the local situation."@en)
SubClassOf(<http://www.biomodels.net/kisao/KISAO#KISAO_0000107> <http://www.biomodels.net/kisao/KISAO#KISAO_0000100>)
DisjointClasses(<http://www.biomodels.net/kisao/KISAO#KISAO_0000107> <http://www.biomodels.net/kisao/KISAO#KISAO_0000108>)

# Class: <http://www.biomodels.net/kisao/KISAO#KISAO_0000108> (progression with fixed time step)

AnnotationAssertion(<http://purl.org/dc/terms/created> <http://www.biomodels.net/kisao/KISAO#KISAO_0000108> "2008-07-08"^^xsd:date)
AnnotationAssertion(<http://purl.org/dc/terms/creator> <http://www.biomodels.net/kisao/KISAO#KISAO_0000108> "NLN"@en)
AnnotationAssertion(rdfs:label <http://www.biomodels.net/kisao/KISAO#KISAO_0000108> "progression with fixed time step"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://www.biomodels.net/kisao/KISAO#KISAO_0000108> "Algorithm, possessing this characteristic, uses time steps of constant length to update the state of a system during the whole simulation."@en)
SubClassOf(<http://www.biomodels.net/kisao/KISAO#KISAO_0000108> <http://www.biomodels.net/kisao/KISAO#KISAO_0000100>)

