SubClassOf(<http://www.biomodels.net/kisao/KISAO#KISAO_0000288> ObjectSomeValuesFrom(<http://www.biomodels.net/kisao/KISAO#KISAO_0000245> <http://www.biomodels.net/kisao/KISAO#KISAO_0000240>))
