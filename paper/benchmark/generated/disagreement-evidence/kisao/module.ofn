AnnotationAssertion(<http://www.biomodels.net/kisao/KISAO#isOrganizational> <http://www.biomodels.net/kisao/KISAO#KISAO_0000095> "true"^^xsd:boolean)
AnnotationAssertion(rdfs:label <http://www.biomodels.net/kisao/KISAO#KISAO_0000095> "sub-volume stochastic reaction-diffusion algorithm"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://www.biomodels.net/kisao/KISAO#KISAO_0000095> "Stochastic method using a combination of discretisation of compartment volumes into voxels and Gillespie-like algorithm [http://identifiers.org/biomodels.kisao/KISAO_0000241] to simulate the evolution of the system."@en)
SubClassOf(<http://www.biomodels.net/kisao/KISAO#KISAO_0000095> <http://www.biomodels.net/kisao/KISAO#KISAO_0000335>)
SubClassOf(<http://www.biomodels.net/kisao/KISAO#KISAO_0000095> ObjectSomeValuesFrom(<http://www.biomodels.net/kisao/KISAO#KISAO_0000245> <http://www.biomodels.net/kisao/KISAO#KISAO_0000102>))
DisjointClasses(<http://www.biomodels.net/kisao/KISAO#KISAO_0000095> <http://www.biomodels.net/kisao/KISAO#KISAO_0000336>)

