AnnotationAssertion(<http://purl.org/dc/terms/creator> <http://www.biomodels.net/kisao/KISAO#KISAO_0000473> "AZ"@en)
AnnotationAssertion(rdfs:label <http://www.biomodels.net/kisao/KISAO#KISAO_0000473> "Bayesian inference algorithm"@en)
AnnotationAssertion(rdfs:seeAlso <http://www.biomodels.net/kisao/KISAO#KISAO_0000473> "http://en.wikipedia.org/wiki/Bayesian_inference"^^xsd:anyURI)
AnnotationAssertion(Annotation(rdfs:comment "George E. P. Box, George C. Tiao. Bayesian Inference in Statistical Analysis, Volume 40 of Wiley Classics Library. John Wiley & Sons (reprint, revised), 2011."@en) rdfs:seeAlso <http://www.biomodels.net/kisao/KISAO#KISAO_0000473> "http://identifiers.org/isbn/111803144X"^^xsd:anyURI)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://www.biomodels.net/kisao/KISAO#KISAO_0000473> "A bayesian inference algorithm calculates a posterior probability distribution from a prior probability distribution and some additional evidence in the form of a likelyhood function."@en)
SubClassOf(<http://www.biomodels.net/kisao/KISAO#KISAO_0000473> <http://www.biomodels.net/kisao/KISAO#KISAO_0000000>)

