SubClassOf(<http://www.biomodels.net/kisao/KISAO#KISAO_0000526> ObjectSomeValuesFrom(<http://www.biomodels.net/kisao/KISAO#KISAO_0000259> <http://www.biomodels.net/kisao/KISAO#KISAO_0000532>))
