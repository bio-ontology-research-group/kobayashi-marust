AnnotationAssertion(rdfs:label <http://www.biomodels.net/kisao/KISAO#KISAO_0000599> "hybrid Gibson - Euler-Maruyama method"@en)
AnnotationAssertion(Annotation(rdfs:comment "H.Salis, V. Sotiropoulos and Y. Kaznessis,'Multiscale Hy3S: Hybrid stochastic simulation for supercomputers', BMC Bioinformatics 7:93 (2006)."@en) rdfs:seeAlso <http://www.biomodels.net/kisao/KISAO#KISAO_0000599> "http://identifiers.org/doi/10.1186/1471-2105-7-93"^^xsd:anyURI)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://www.biomodels.net/kisao/KISAO#KISAO_0000599> "A hybrid stochastic method partitions the system into subsets of fast and slow reactions and approximates the fast reactions as a continuous Markov process, using a chemical Langevin equation, and accurately describes the slow dynamics using the Gibson algorithm. Fixed time step Milstein is used for approximate numerical solution of CLE."@en)
