AnnotationAssertion(Annotation(rdfs:comment "Smallbone K, Simeonidis E. Flux balance analysis: a geometric perspective. J Theor Biol. 2009;258(2):311-315."@en) rdfs:seeAlso <http://www.biomodels.net/kisao/KISAO#KISAO_0000527> "http://identifiers.org/doi/10.1016/j.jtbi.2009.01.027"^^xsd:anyURI)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#altLabel> <http://www.biomodels.net/kisao/KISAO#KISAO_0000527> "gFBA"@en)
