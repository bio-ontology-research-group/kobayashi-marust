SubClassOf(<http://www.biomodels.net/kisao/KISAO#KISAO_0000378> ObjectSomeValuesFrom(<http://www.biomodels.net/kisao/KISAO#KISAO_0000245> <http://www.biomodels.net/kisao/KISAO#KISAO_0000240>))
SubClassOf(<http://www.biomodels.net/kisao/KISAO#KISAO_0000378> ObjectSomeValuesFrom(<http://www.biomodels.net/kisao/KISAO#KISAO_0000245> <http://www.biomodels.net/kisao/KISAO#KISAO_0000374>))
SubClassOf(<http://www.biomodels.net/kisao/KISAO#KISAO_0000378> DataHasValue(<http://www.biomodels.net/kisao/KISAO#KISAO_0000275> "2"^^xsd:integer))

# Class: <http://www.biomodels.net/kisao/KISAO#KISAO_0000380> (Richardson extrapolation based method)

AnnotationAssertion(<http://purl.org/dc/terms/created> <http://www.biomodels.net/kisao/KISAO#KISAO_0000380> "2011-07-01"^^xsd:date)
AnnotationAssertion(<http://purl.org/dc/terms/creator> <http://www.biomodels.net/kisao/KISAO#KISAO_0000380> "AZ"@en)
AnnotationAssertion(<http://www.biomodels.net/kisao/KISAO#isOrganizational> <http://www.biomodels.net/kisao/KISAO#KISAO_0000380> "true"^^xsd:boolean)
AnnotationAssertion(rdfs:label <http://www.biomodels.net/kisao/KISAO#KISAO_0000380> "Richardson extrapolation based method"@en)
AnnotationAssertion(Annotation(rdfs:comment "Richardson, L. F. (1911). The approximate arithmetical solution by finite differences of physical problems including differential equations, with an application to the stresses in a masonry dam. Philosophical Transactions of the Royal Society of London, Series A 210 (459-470): 307-357."@en) rdfs:seeAlso <http://www.biomodels.net/kisao/KISAO#KISAO_0000380> "http://identifiers.org/doi/10.1098/rsta.1911.0009"^^xsd:anyURI)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://www.biomodels.net/kisao/KISAO#KISAO_0000380> "A method based on ideas of Richardson extrapolation, which is a process for obtaining increased accuracy in a discretized approximation by extrapolating results from coarse discretizations to an arbitrarily fine one."@en)
SubClassOf(<http://www.biomodels.net/kisao/KISAO#KISAO_0000380> <http://www.biomodels.net/kisao/KISAO#KISAO_0000377>)

# Class: <http://www.biomodels.net/kisao/KISAO#KISAO_0000381> (midpoint method)

AnnotationAssertion(<http://purl.org/dc/terms/created> <http://www.biomodels.net/kisao/KISAO#KISAO_0000381> "2011-07-01"^^xsd:date)
AnnotationAssertion(<http://purl.org/dc/terms/creator> <http://www.biomodels.net/kisao/KISAO#KISAO_0000381> "AZ"@en)
AnnotationAssertion(rdfs:label <http://www.biomodels.net/kisao/KISAO#KISAO_0000381> "midpoint method"@en)
AnnotationAssertion(Annotation(rdfs:comment "Hairer, Ernst; Nørsett, Syvert Paul; Wanner, Gerhard (1993), Solving ordinary differential equations I: Nonstiff problems (2nd ed.), Berlin: Springer Verlag."@en) rdfs:seeAlso <http://www.biomodels.net/kisao/KISAO#KISAO_0000381> "http://identifiers.org/isbn/978-3-540-56670-0"^^xsd:anyURI)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://www.biomodels.net/kisao/KISAO#KISAO_0000381> "The midpoint method is an explicit method for approximating the solution of the initial value problem y' = f(x,y);  y(x0) = y0 at x for a given step size h. For the midpoint method the derivative of y(x) is approximated by the symmetric difference y'(x) = ( y(x+h) - y(x-h) ) / 2h + O(h2)."@en)
SubClassOf(<http://www.biomodels.net/kisao/KISAO#KISAO_0000381> <http://www.biomodels.net/kisao/KISAO#KISAO_0000064>)
SubClassOf(<http://www.biomodels.net/kisao/KISAO#KISAO_0000381> ObjectSomeValuesFrom(<http://www.biomodels.net/kisao/KISAO#KISAO_0000245> <http://www.biomodels.net/kisao/KISAO#KISAO_0000103>))
SubClassOf(<http://www.biomodels.net/kisao/KISAO#KISAO_0000381> ObjectSomeValuesFrom(<http://www.biomodels.net/kisao/KISAO#KISAO_0000245> <http://www.biomodels.net/kisao/KISAO#KISAO_0000239>))
SubClassOf(<http://www.biomodels.net/kisao/KISAO#KISAO_0000381> ObjectSomeValuesFrom(<http://www.biomodels.net/kisao/KISAO#KISAO_0000245> <http://www.biomodels.net/kisao/KISAO#KISAO_0000374>))
SubClassOf(<http://www.biomodels.net/kisao/KISAO#KISAO_0000381> DataHasValue(<http://www.biomodels.net/kisao/KISAO#KISAO_0000275> "2"^^xsd:integer))

# Class: <http://www.biomodels.net/kisao/KISAO#KISAO_0000382> (modified midpoint method)

AnnotationAssertion(<http://purl.org/dc/terms/created> <http://www.biomodels.net/kisao/KISAO#KISAO_0000382> "2011-07-01"^^xsd:date)
AnnotationAssertion(<http://purl.org/dc/terms/creator> <http://www.biomodels.net/kisao/KISAO#KISAO_0000382> "AZ"@en)
AnnotationAssertion(rdfs:label <http://www.biomodels.net/kisao/KISAO#KISAO_0000382> "modified midpoint method"@en)
AnnotationAssertion(Annotation(rdfs:comment "Press WH, Teukolsky SA, Vetterling WT, Flannery BP. Numerical Recipes in Fortran 77. Cambridge University Press (2001)."@en) rdfs:seeAlso <http://www.biomodels.net/kisao/KISAO#KISAO_0000382> "http://identifiers.org/isbn/052143064X"^^xsd:anyURI)
AnnotationAssertion(Annotation(rdfs:comment "EXACT"@en) <http://www.w3.org/2004/02/skos/core#altLabel> <http://www.biomodels.net/kisao/KISAO#KISAO_0000382> "Gragg's method"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#altLabel> <http://www.biomodels.net/kisao/KISAO#KISAO_0000382> "Gragg's modified midpoint method"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://www.biomodels.net/kisao/KISAO#KISAO_0000382> "The modified midpoint method is globally a second order method for approximating the solution of the initial value problem y' = f(x, y), y(x0) = y0, which advances a vector of dependent variables y(x) from a point x to a point x + H by a sequence of n substeps each of size h, h = H/n.
"@en)
SubClassOf(<http://www.biomodels.net/kisao/KISAO#KISAO_0000382> <http://www.biomodels.net/kisao/KISAO#KISAO_0000064>)
SubClassOf(<http://www.biomodels.net/kisao/KISAO#KISAO_0000382> ObjectSomeValuesFrom(<http://www.biomodels.net/kisao/KISAO#KISAO_0000245> <http://www.biomodels.net/kisao/KISAO#KISAO_0000103>))
SubClassOf(<http://www.biomodels.net/kisao/KISAO#KISAO_0000382> ObjectSomeValuesFrom(<http://www.biomodels.net/kisao/KISAO#KISAO_0000245> <http://www.biomodels.net/kisao/KISAO#KISAO_0000239>))
SubClassOf(<http://www.biomodels.net/kisao/KISAO#KISAO_0000382> ObjectSomeValuesFrom(<http://www.biomodels.net/kisao/KISAO#KISAO_0000245> <http://www.biomodels.net/kisao/KISAO#KISAO_0000374>))

# Class: <http://www.biomodels.net/kisao/KISAO#KISAO_0000384> (semi-implicit midpoint rule)

AnnotationAssertion(<http://purl.org/dc/terms/created> <http://www.biomodels.net/kisao/KISAO#KISAO_0000384> "2011-07-01"^^xsd:date)
AnnotationAssertion(<http://purl.org/dc/terms/creator> <http://www.biomodels.net/kisao/KISAO#KISAO_0000384> "AZ"@en)
AnnotationAssertion(rdfs:label <http://www.biomodels.net/kisao/KISAO#KISAO_0000384> "semi-implicit midpoint rule"@en)
AnnotationAssertion(Annotation(rdfs:comment "Bader, G. and Deuflhard, P. \"A Semi-Implicit Mid-Point Rule for Stiff Systems of Ordinary Differential Equations.\" Numer. Math. 41, 373-398, 1983."@en) rdfs:seeAlso <http://www.biomodels.net/kisao/KISAO#KISAO_0000384> "http://identifiers.org/doi/10.1007/BF01418331"^^xsd:anyURI)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://www.biomodels.net/kisao/KISAO#KISAO_0000384> "A semi-implicit version of the midpoint method that has an even error series [http://identifiers.org/biomodels.kisao/KISAO_0000381]."@en)
SubClassOf(<http://www.biomodels.net/kisao/KISAO#KISAO_0000384> <http://www.biomodels.net/kisao/KISAO#KISAO_0000064>)
SubClassOf(<http://www.biomodels.net/kisao/KISAO#KISAO_0000384> ObjectSomeValuesFrom(<http://www.biomodels.net/kisao/KISAO#KISAO_0000245> <http://www.biomodels.net/kisao/KISAO#KISAO_0000103>))
SubClassOf(<http://www.biomodels.net/kisao/KISAO#KISAO_0000384> ObjectSomeValuesFrom(<http://www.biomodels.net/kisao/KISAO#KISAO_0000245> <http://www.biomodels.net/kisao/KISAO#KISAO_0000240>))
SubClassOf(<http://www.biomodels.net/kisao/KISAO#KISAO_0000384> ObjectSomeValuesFrom(<http://www.biomodels.net/kisao/KISAO#KISAO_0000245> <http://www.biomodels.net/kisao/KISAO#KISAO_0000374>))

# Class: <http://www.biomodels.net/kisao/KISAO#KISAO_0000397> (preconditioning technique)

AnnotationAssertion(<http://purl.org/dc/terms/created> <http://www.biomodels.net/kisao/KISAO#KISAO_0000397> "2011-07-19"^^xsd:date)
AnnotationAssertion(<http://purl.org/dc/terms/creator> <http://www.biomodels.net/kisao/KISAO#KISAO_0000397> "AZ"@en)
AnnotationAssertion(rdfs:label <http://www.biomodels.net/kisao/KISAO#KISAO_0000397> "preconditioning technique"@en)
AnnotationAssertion(Annotation(rdfs:comment "Saad, Yousef (2003). Iterative methods for sparse linear systems (2nd ed.). SIAM."@en) rdfs:seeAlso <http://www.biomodels.net/kisao/KISAO#KISAO_0000397> "http://identifiers.org/isbn/0898715342"^^xsd:anyURI)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://www.biomodels.net/kisao/KISAO#KISAO_0000397> "Preconditioning is simply a means of transforming the original linear system into one which has the same solution, but which is likely to be easier to solve with an iterative solver."@en)
