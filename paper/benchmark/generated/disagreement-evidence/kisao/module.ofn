AnnotationAssertion(rdfs:label <http://www.biomodels.net/kisao/KISAO#KISAO_0000102> "spatial description"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://www.biomodels.net/kisao/KISAO#KISAO_0000102> "Algorithm, possessing this characteristic, takes into account the location of the reacting components."@en)
SubClassOf(<http://www.biomodels.net/kisao/KISAO#KISAO_0000102> <http://www.biomodels.net/kisao/KISAO#KISAO_0000097>)

# Class: <http://www.biomodels.net/kisao/KISAO#KISAO_0000103> (deterministic system behaviour)

AnnotationAssertion(<http://purl.org/dc/terms/created> <http://www.biomodels.net/kisao/KISAO#KISAO_0000103> "2008-07-08"^^xsd:date)
AnnotationAssertion(<http://purl.org/dc/terms/creator> <http://www.biomodels.net/kisao/KISAO#KISAO_0000103> "NLN"@en)
AnnotationAssertion(rdfs:label <http://www.biomodels.net/kisao/KISAO#KISAO_0000103> "deterministic system behaviour"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://www.biomodels.net/kisao/KISAO#KISAO_0000103> "Algorithm, possessing this characteristic, simulates the temporal evolution of a system deterministically, so that from a precise initial state the algorithm will always end up in the same final state."@en)
SubClassOf(<http://www.biomodels.net/kisao/KISAO#KISAO_0000103> <http://www.biomodels.net/kisao/KISAO#KISAO_0000099>)
DisjointClasses(<http://www.biomodels.net/kisao/KISAO#KISAO_0000103> <http://www.biomodels.net/kisao/KISAO#KISAO_0000104>)

# Class: <http://www.biomodels.net/kisao/KISAO#KISAO_0000104> (stochastic system behaviour)

AnnotationAssertion(<http://purl.org/dc/terms/created> <http://www.biomodels.net/kisao/KISAO#KISAO_0000104> "2008-07-08"^^xsd:date)
AnnotationAssertion(<http://purl.org/dc/terms/creator> <http://www.biomodels.net/kisao/KISAO#KISAO_0000104> "NLN"@en)
AnnotationAssertion(rdfs:label <http://www.biomodels.net/kisao/KISAO#KISAO_0000104> "stochastic system behaviour"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://www.biomodels.net/kisao/KISAO#KISAO_0000104> "Algorithm, possessing this characteristic, simulates the temporal evolution of a system using probabilistic rules, so that between two simulations, the same precise initial state may result in a different final state."@en)
SubClassOf(<http://www.biomodels.net/kisao/KISAO#KISAO_0000104> <http://www.biomodels.net/kisao/KISAO#KISAO_0000099>)

# Class: <http://www.biomodels.net/kisao/KISAO#KISAO_0000105> (discrete variable)

AnnotationAssertion(<http://purl.org/dc/terms/created> <http://www.biomodels.net/kisao/KISAO#KISAO_0000105> "2008-07-08"^^xsd:date)
AnnotationAssertion(<http://purl.org/dc/terms/creator> <http://www.biomodels.net/kisao/KISAO#KISAO_0000105> "NLN"@en)
AnnotationAssertion(rdfs:label <http://www.biomodels.net/kisao/KISAO#KISAO_0000105> "discrete variable"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://www.biomodels.net/kisao/KISAO#KISAO_0000105> "Algorithm, possessing this characteristic, allows values of system's variables to change by discrete (integral) amounts."@en)
SubClassOf(<http://www.biomodels.net/kisao/KISAO#KISAO_0000105> <http://www.biomodels.net/kisao/KISAO#KISAO_0000098>)
