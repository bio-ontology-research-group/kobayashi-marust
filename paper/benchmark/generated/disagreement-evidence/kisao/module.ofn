# Class: <http://www.biomodels.net/kisao/KISAO#KISAO_0000522> (start temperature)

AnnotationAssertion(<http://purl.org/dc/terms/created> <http://www.biomodels.net/kisao/KISAO#KISAO_0000522> "2019-01-18"^^xsd:date)
AnnotationAssertion(<http://purl.org/dc/terms/creator> <http://www.biomodels.net/kisao/KISAO#KISAO_0000522> "AZ"@en)
AnnotationAssertion(rdfs:label <http://www.biomodels.net/kisao/KISAO#KISAO_0000522> "start temperature"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://www.biomodels.net/kisao/KISAO#KISAO_0000522> "Initial temperature of the system. The higher the temperature, the larger the probability that a global optimum is found. Note that the temperature should be very high in the beginning of the method (the system should be above the \"melting\" temperature). This value has the same units as the objective function, so what represents \"high\" is different from problem to problem."@en)
SubClassOf(<http://www.biomodels.net/kisao/KISAO#KISAO_0000522> <http://www.biomodels.net/kisao/KISAO#KISAO_0000521>)
DisjointClasses(<http://www.biomodels.net/kisao/KISAO#KISAO_0000522> <http://www.biomodels.net/kisao/KISAO#KISAO_0000523>)

# Class: <http://www.biomodels.net/kisao/KISAO#KISAO_0000523> (cooling factor)

AnnotationAssertion(<http://purl.org/dc/terms/created> <http://www.biomodels.net/kisao/KISAO#KISAO_0000523> "2019-01-18"^^xsd:date)
AnnotationAssertion(<http://purl.org/dc/terms/creator> <http://www.biomodels.net/kisao/KISAO#KISAO_0000523> "AZ"@en)
AnnotationAssertion(rdfs:label <http://www.biomodels.net/kisao/KISAO#KISAO_0000523> "cooling factor"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://www.biomodels.net/kisao/KISAO#KISAO_0000523> "Rate by which the temperature is reduced from one cycle to the next, given by the formula: Tnew=Told*\"Cooling Factor\". The simulated annealing algorithm works best if the temperature is reduced at a slow rate, so this value should be close to 1."@en)
SubClassOf(<http://www.biomodels.net/kisao/KISAO#KISAO_0000523> <http://www.biomodels.net/kisao/KISAO#KISAO_0000521>)
SubClassOf(<http://www.biomodels.net/kisao/KISAO#KISAO_0000523> DataSomeValuesFrom(<http://www.biomodels.net/kisao/KISAO#KISAO_0000251> xsd:double))

# Class: <http://www.biomodels.net/kisao/KISAO#KISAO_0000524> (partitioned leaping method)

AnnotationAssertion(<http://purl.org/dc/terms/created> <http://www.biomodels.net/kisao/KISAO#KISAO_0000524> "2020-05-29"^^xsd:date)
AnnotationAssertion(<http://purl.org/dc/terms/creator> <http://www.biomodels.net/kisao/KISAO#KISAO_0000524> "AZ"@en)
AnnotationAssertion(Annotation(rdfs:comment "BioNetGen"@end) <http://www.biomodels.net/kisao/KISAO#isImplementedIn> <http://www.biomodels.net/kisao/KISAO#KISAO_0000524> "http://identifiers.org/biosimulators/bionetgen"^^xsd:anyURI)
AnnotationAssertion(rdfs:label <http://www.biomodels.net/kisao/KISAO#KISAO_0000524> "partitioned leaping method"@en)
AnnotationAssertion(Annotation(rdfs:comment "Harris LA, Clancy P. A \"partitioned leaping\" approach for multiscale modeling of chemical reaction dynamics. J Chem Phys. 125 (14), 144107 (2006)."@en) rdfs:seeAlso <http://www.biomodels.net/kisao/KISAO#KISAO_0000524> "http://identifiers.org/doi/10.1063/1.2354085"^^xsd:anyURI)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://www.biomodels.net/kisao/KISAO#KISAO_0000524> "Multiscale simulation approach for modeling stochasticity in chemical reaction networks. The approach seamlessly integrates exact-stochastic and \"leaping\" methodologies into a single partitioned leaping algorithmic framework. The technique correctly accounts for stochastic noise at significantly reduced computational cost, requires the definition of only three modelindependent parameters and is particularly well-suited for simulating systems containing widely disparate species populations."@en)
SubClassOf(<http://www.biomodels.net/kisao/KISAO#KISAO_0000524> <http://www.biomodels.net/kisao/KISAO#KISAO_0000039>)
SubClassOf(<http://www.biomodels.net/kisao/KISAO#KISAO_0000524> ObjectSomeValuesFrom(<http://www.biomodels.net/kisao/KISAO#KISAO_0000259> <http://www.biomodels.net/kisao/KISAO#KISAO_0000488>))

