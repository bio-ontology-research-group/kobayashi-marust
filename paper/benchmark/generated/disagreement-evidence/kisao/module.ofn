AnnotationAssertion(Annotation(rdfs:comment "Pedro Mendes, Stefan Hoops, Sven Sahle, Ralph Gauges, Joseph Dada & Ursula Kummer. Computational modeling of biochemical networks using COPASI. Methods in Molecular Biology 500, 17–59 (2009)."@en) rdfs:seeAlso <http://www.biomodels.net/kisao/KISAO#KISAO_0000560> "http://identifiers.org/doi/10.1007/978-1-59745-525-1_2"^^xsd:anyURI)
