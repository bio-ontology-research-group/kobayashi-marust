AnnotationAssertion(<http://purl.org/dc/terms/creator> <http://www.biomodels.net/kisao/KISAO#KISAO_0000301> "AZ"@en)
AnnotationAssertion(rdfs:label <http://www.biomodels.net/kisao/KISAO#KISAO_0000301> "Heun method"@en)
AnnotationAssertion(Annotation(rdfs:comment "Hairer, Ernst; Nørsett, Syvert Paul; Wanner, Gerhard (1993), Solving ordinary differential equations I: Nonstiff problems (2nd ed.), Berlin: Springer Verlag"@en) rdfs:seeAlso <http://www.biomodels.net/kisao/KISAO#KISAO_0000301> "http://identifiers.org/isbn/978-3-540-56670-0"^^xsd:anyURI)
AnnotationAssertion(Annotation(rdfs:comment "EXACT"@en) <http://www.w3.org/2004/02/skos/core#altLabel> <http://www.biomodels.net/kisao/KISAO#KISAO_0000301> "Heun's method"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://www.biomodels.net/kisao/KISAO#KISAO_0000301> "The method is named after Karl L. W. M. Heun and is a numerical procedure for solving ordinary differential equations (ODEs) with a given initial value. It can be seen as extension of the Euler method [http://identifiers.org/biomodels.kisao/KISAO_0000261] into two-stage second-order Runge-Kutta method."@en)
SubClassOf(<http://www.biomodels.net/kisao/KISAO#KISAO_0000301> <http://www.biomodels.net/kisao/KISAO#KISAO_0000064>)
