AnnotationAssertion(<http://purl.org/dc/terms/creator> <http://www.biomodels.net/kisao/KISAO#KISAO_0000528> "AZ"@en)
AnnotationAssertion(Annotation(rdfs:comment "CBMPy"@end) <http://www.biomodels.net/kisao/KISAO#isImplementedIn> <http://www.biomodels.net/kisao/KISAO#KISAO_0000528> "http://identifiers.org/biosimulators/cbmpy"^^xsd:anyURI)
AnnotationAssertion(Annotation(rdfs:comment "COBRApy"@end) <http://www.biomodels.net/kisao/KISAO#isImplementedIn> <http://www.biomodels.net/kisao/KISAO#KISAO_0000528> "http://identifiers.org/biosimulators/cobrapy"^^xsd:anyURI)
