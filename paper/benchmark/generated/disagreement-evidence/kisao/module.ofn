AnnotationAssertion(rdfs:label <http://www.biomodels.net/kisao/KISAO#KISAO_0000437> "flux balance analysis"@en)
AnnotationAssertion(Annotation(rdfs:comment "Jeffrey D Orth, Ines Thiele and Bernhard O Palsson (2010) What is flux balance analysis? Nature Biotechnology 28, 245–248"@en) rdfs:seeAlso <http://www.biomodels.net/kisao/KISAO#KISAO_0000437> "http://identifiers.org/doi/10.1038/nbt.1614"^^xsd:anyURI)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#altLabel> <http://www.biomodels.net/kisao/KISAO#KISAO_0000437> "FBA"@en)
