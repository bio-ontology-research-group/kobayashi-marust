AnnotationAssertion(<http://purl.org/dc/terms/creator> <http://www.biomodels.net/kisao/KISAO#KISAO_0000470> "AZ"@en)
AnnotationAssertion(<http://www.biomodels.net/kisao/KISAO#isOrganizational> <http://www.biomodels.net/kisao/KISAO#KISAO_0000470> "true"^^xsd:boolean)
