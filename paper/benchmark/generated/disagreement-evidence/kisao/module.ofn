AnnotationAssertion(<http://purl.org/dc/terms/creator> <http://www.biomodels.net/kisao/KISAO#KISAO_0000525> "AZ"@en)
AnnotationAssertion(Annotation(rdfs:comment "BioNetGen"@end) <http://www.biomodels.net/kisao/KISAO#isImplementedIn> <http://www.biomodels.net/kisao/KISAO#KISAO_0000525> "http://identifiers.org/biosimulators/bionetgen"^^xsd:anyURI)
AnnotationAssertion(rdfs:label <http://www.biomodels.net/kisao/KISAO#KISAO_0000525> "stop condition"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://www.biomodels.net/kisao/KISAO#KISAO_0000525> "A condition upon which a simulation should terminate."@en)
