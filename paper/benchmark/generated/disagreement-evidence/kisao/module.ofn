SubClassOf(<http://www.biomodels.net/kisao/KISAO#KISAO_0000301> ObjectSomeValuesFrom(<http://www.biomodels.net/kisao/KISAO#KISAO_0000245> <http://www.biomodels.net/kisao/KISAO#KISAO_0000108>))
SubClassOf(<http://www.biomodels.net/kisao/KISAO#KISAO_0000301> ObjectSomeValuesFrom(<http://www.biomodels.net/kisao/KISAO#KISAO_0000245> <http://www.biomodels.net/kisao/KISAO#KISAO_0000239>))
SubClassOf(<http://www.biomodels.net/kisao/KISAO#KISAO_0000301> ObjectSomeValuesFrom(<http://www.biomodels.net/kisao/KISAO#KISAO_0000245> <http://www.biomodels.net/kisao/KISAO#KISAO_0000374>))
SubClassOf(<http://www.biomodels.net/kisao/KISAO#KISAO_0000301> DataHasValue(<http://www.biomodels.net/kisao/KISAO#KISAO_0000275> "2"^^xsd:integer))

# Class: <http://www.biomodels.net/kisao/KISAO#KISAO_0000302> (embedded Runge-Kutta method)

