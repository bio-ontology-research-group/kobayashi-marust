AnnotationAssertion(<http://purl.org/dc/terms/creator> <http://www.biomodels.net/kisao/KISAO#KISAO_0000296> "AZ"@en)
AnnotationAssertion(rdfs:label <http://www.biomodels.net/kisao/KISAO#KISAO_0000296> "Hammer-Hollingsworth method"@en)
AnnotationAssertion(Annotation(rdfs:comment "P. C. Hammer & J. W. Hollingsworth, Trapezoidal methods of approximating solutions of differential equations, MTAC, v. 9, 1955, pp. 92-96. MR 17, 302."@en) rdfs:seeAlso <http://www.biomodels.net/kisao/KISAO#KISAO_0000296> "urn:issn:0891-6837"^^xsd:anyURI)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://www.biomodels.net/kisao/KISAO#KISAO_0000296> "The numerical integration of ordinary differential equations by the use of Gaussian quadrature methods."@en)
