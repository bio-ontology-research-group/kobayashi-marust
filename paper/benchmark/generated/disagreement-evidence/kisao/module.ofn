AnnotationAssertion(Annotation(rdfs:comment "Wold S, Martens H, Wold H (1983) The multivariate calibration method in chemistry solved by the PLS method. In: Lecture notes in Mathematics, Matrix Pencils. Heidelberg: Springer-Verlag. pp. 286-293."@en) rdfs:seeAlso <http://www.biomodels.net/kisao/KISAO#KISAO_0000420> "http://identifiers.org/biomodels.kisao/10.1007/BFb0062108"^^xsd:anyURI)
