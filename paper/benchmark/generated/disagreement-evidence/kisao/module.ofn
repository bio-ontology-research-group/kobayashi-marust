AnnotationAssertion(Annotation(rdfs:comment "Mahadevan R, Schilling CH. The effects of alternate optimal solutions in constraint-based genome-scale metabolic models. Metab Eng. 2003;5(4):264-276."@en) rdfs:seeAlso <http://www.biomodels.net/kisao/KISAO#KISAO_0000526> "http://identifiers.org/doi/10.1016/j.ymben.2003.09.002"^^xsd:anyURI)
