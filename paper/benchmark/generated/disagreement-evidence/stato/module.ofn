AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000117> <http://purl.obolibrary.org/obo/STATO_0000344> "Philippe Rocca-Serra")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/STATO_0000344> "has effect on"@en)
SubObjectPropertyOf(<http://purl.obolibrary.org/obo/STATO_0000344> <http://purl.obolibrary.org/obo/IAO_0000136>)
ObjectPropertyDomain(<http://purl.obolibrary.org/obo/STATO_0000344> <http://purl.obolibrary.org/obo/STATO_0000258>)
ObjectPropertyRange(<http://purl.obolibrary.org/obo/STATO_0000344> <http://purl.obolibrary.org/obo/STATO_0000258>)

