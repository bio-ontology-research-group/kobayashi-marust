AnnotationAssertion(<http://purl.obolibrary.org/obo/STATO_0000041> <http://purl.obolibrary.org/obo/STATO_0000237> "sd(x, na.rm = FALSE)

http://stat.ethz.ch/R-manual/R-patched/library/stats/html/sd.html"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/STATO_0000237> "standard deviation"@en)
SubClassOf(<http://purl.obolibrary.org/obo/STATO_0000237> <http://purl.obolibrary.org/obo/STATO_0000028>)

