<?xml version="1.0"?>
<?eclipse version="3.0"?>
<plugin>

   <!-- Register Kobayashi-MaRust in Protege's Reasoner menu. -->
   <extension id="KobayashiMarustReasonerFactory"
              point="org.protege.editor.owl.inference_reasonerfactory">
      <reasonerFactory name="Kobayashi-MaRust"
                       factoryClass="org.bioontology.kobayashimarust.protege.KMReasonerInfo"/>
   </extension>

   <!-- Protégé's standard Explain action opens this native KM result panel
        for the named SubClassOf entailments advertised by hasExplanation. -->
   <extension id="KobayashiMarustNativeExplanation"
              point="org.protege.editor.owl.explanation">
      <name value="Kobayashi-MaRust native source justifications"/>
      <class value="org.bioontology.kobayashimarust.protege.KMNativeExplanationService"/>
   </extension>

</plugin>
